# Copy to .env.local. These Firebase WEB values are public-safe (not the admin key)
# but still keep them out of git so you can swap projects without a diff.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=planogram-adherance-ver-1.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://planogram-adherance-ver-1-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=planogram-adherance-ver-1
VITE_FIREBASE_STORAGE_BUCKET=planogram-adherance-ver-1.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# FastAPI base URL
VITE_API_BASE_URL=http://localhost:8000
